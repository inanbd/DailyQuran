<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DailyQuran.Web</RootNamespace>
    <!--
      The repository root. The site reads the app's own Qur'an data, privacy
      policy and changelog from there rather than keeping copies that could
      drift from what the app ships.
    -->
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DailyQuran.Web.Tests" />
  </ItemGroup>

  <!--
    Qur'an data: the edition catalog, surah index, word index and every
    verified edition. The development fixture is left out; it is not the
    Qur'an and has no place on a public site.
  -->
  <ItemGroup>
    <None Include="$(RepoRoot)assets/data/catalog.json;$(RepoRoot)assets/data/surahs.json;$(RepoRoot)assets/data/word_by_word.json"
          Link="data/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)assets/data/editions/*.json"
          Exclude="$(RepoRoot)assets/data/editions/dev_sample.json"
          Link="data/editions/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(RepoRoot)PRIVACY.md;$(RepoRoot)CHANGELOG.md"
          Link="content/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
