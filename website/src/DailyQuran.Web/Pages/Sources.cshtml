@page "/sources"
@model SourcesModel
@{
    ViewData["Title"] = "Sources & licences";
    ViewData["Description"] = "Where the Qur’an text, translations and word-by-word glosses on Daily Quran come from, and the licences they are shared under.";
    ViewData["Canonical"] = "/sources";
}

<section class="band page-hero" aria-labelledby="page-title">
    <div class="container narrow center">
        <p class="eyebrow centered">Sources &amp; licences</p>
        <h1 id="page-title">Every word, credited</h1>
        <p class="lead">
            The Qur’an text and its translations are copied verbatim from the sources below —
            never generated, paraphrased, completed or corrected.
        </p>
    </div>
</section>

<section class="section">
    <div class="container narrow">
        <article class="prose">
            <h2>Editions</h2>
            <p>
                Each edition carries the Uthmani Arabic, and all but one a translation. They are the same
                files the app ships, shared here under the same licence.
            </p>
        </article>

        <ul class="source-list">
            @foreach (Edition edition in Model.Editions)
            {
                <li class="source-card">
                    <div class="source-head">
                        <h3>@edition.Title</h3>
                        <span class="tag">@(edition.HasTranslation ? edition.LanguageDisplay : "Arabic")</span>
                    </div>
                    @if (edition.Description.Length > 0)
                    {
                        <p>@edition.Description</p>
                    }
                    <dl>
                        @if (edition.Translator.Length > 0)
                        {
                            <div><dt>Translator</dt><dd>@edition.Translator</dd></div>
                        }
                        <div>
                            <dt>Source</dt>
                            <dd>
                                @if (edition.Source.Url is { Length: > 0 } url)
                                {
                                    <a href="@url">@edition.Source.Name</a>
                                }
                                else
                                {
                                    @edition.Source.Name
                                }
                            </dd>
                        </div>
                        @if (edition.Source.Licence is { Length: > 0 } licence)
                        {
                            <div><dt>Licence</dt><dd>@licence</dd></div>
                        }
                    </dl>
                    <a class="text-link" href="/quran/1?t=@edition.Id">Read in this edition @Icon.ArrowRight</a>
                </li>
            }
        </ul>

        <article class="prose">
            <p>
                The editions are adapted from <a href="https://github.com/risan/quran-json">quran-json</a>
                by Risan Bagja Pradana — the Uthmani text from The Noble Qur’an Encyclopedia, and the
                translations from Tanzil.net — and are distributed under the
                <a href="https://creativecommons.org/licenses/by-sa/4.0/">Creative Commons Attribution-ShareAlike 4.0</a>
                licence. If you adapt them further, your versions carry the same licence.
            </p>

            @if (Model.WordIndex is { } words)
            {
                <h2>Word by word</h2>
                <p>@words.Notice</p>
                <p>
                    Glosses in @words.LanguageName, from
                    @if (words.Source.Url is { Length: > 0 } wordsUrl)
                    {
                        <a href="@wordsUrl">@words.Source.Name</a>
                    }
                    else
                    {
                        @words.Source.Name
                    }.
                    @if (words.Source.Licence is { Length: > 0 } wordsLicence)
                    {
                        <text>Licence: @wordsLicence.</text>
                    }
                </p>
            }

            <h2>Surah names</h2>
            <p>
                Surah names, lengths and their Meccan or Medinan classification follow the standard Kufan
                numbering of 6,236 ayat. This is reference data, and contains no Qur’an text.
            </p>

            <h2>Typefaces</h2>
            <p>All served from this website, under the SIL Open Font License 1.1.</p>
            <ul>
                @foreach ((string name, string use, string licence) in SourcesModel.Fonts)
                {
                    <li><strong>@name</strong> — for @use. <a href="/fonts/@licence">Licence</a></li>
                }
            </ul>

            <h2>Store badges</h2>
            <p>
                Google Play and the Google Play logo are trademarks of Google LLC. App Store and the Apple
                logo are trademarks of Apple Inc.
            </p>

            <h2>Something wrong?</h2>
            <p>
                If you find an error in any text, please <a href="/contact">tell us</a> — with the surah,
                the ayah and the edition — and we will check it against its source.
            </p>
        </article>
    </div>
</section>
