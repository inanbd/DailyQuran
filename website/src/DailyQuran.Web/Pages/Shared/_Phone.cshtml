@model PhoneShot
<figure class="phone @Model.CssClass">
    @if (Model.Eager)
    {
        @* The first large image on the page: fetched first, so the page is complete sooner. *@
        <img src="@Url.Content($"~/img/screens/{Model.File}")" alt="@Model.Alt" width="600" height="1200" fetchpriority="high">
    }
    else
    {
        <img src="@Url.Content($"~/img/screens/{Model.File}")" alt="@Model.Alt" width="600" height="1200" loading="lazy" decoding="async">
    }
</figure>
